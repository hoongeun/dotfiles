[global]
    monitor = 0
    follow = mouse
    origin = top-right
    offset = 16x40
    width = (360, 440)
    height = 200
    notification_limit = 3
    gap_size = 8

    padding = 16
    horizontal_padding = 16
    frame_width = 2
    frame_color = "#ffffff1a"
    corner_radius = 12
    separator_height = 0

    progress_bar_height = 4
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 2

    font = Inter Nerd Font 13
    markup = full
    format = "<b>%s</b>\n<span foreground='#888888'>%b</span>"
    alignment = left
    ellipsize = end
    word_wrap = yes
    ignore_newline = yes
    show_age_threshold = -1

    icon_position = off

    sticky_history = yes
    history_length = 30
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

[urgency_low]
    background = "#111111"
    foreground = "#888888"
    timeout = 4

[urgency_normal]
    background = "#111111"
    foreground = "#ffffff"
    timeout = 6

[urgency_critical]
    background = "#111111"
    foreground = "#ffffff"
    frame_color = "#ff453a99"
    timeout = 0

# fcitx5 warns about GTK_IM_MODULE; it is kept because the Wayland text-input path misorders Hangul commits.
[fcitx5_wayland_diagnose]
    appname = Fcitx
    summary = "Wayland Diagnose"
    skip_display = true
    history_ignore = true
