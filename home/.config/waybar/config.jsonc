{
    "layer": "top",
    "position": "top",
    "height": 28,

    "modules-left": ["custom/calendar", "hyprland/workspaces", "hyprland/window"],
    "modules-center": [],
    "modules-right": [
        "custom/claude", "custom/codex", "custom/copilot",
        "disk", "pulseaudio", "memory", "cpu",
        "custom/network", "custom/tailscale", "tray", "custom/battery", "clock"
    ],

    "custom/calendar": {
        "exec": "export PATH=/home/linuxbrew/.linuxbrew/bin:$PATH; python3 -I $HOME/.config/waybar/scripts/khal-next.py | jq -Rc '{text:.}'",
        "return-type": "json",
        "interval": 60,
        "align": 0,
        "on-click": "xdg-open https://calendar.google.com"
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 40,
        "separate-outputs": true
    },

    "custom/claude": {
        "exec": "$HOME/.config/waybar/scripts/pango.sh claude-usage.sh",
        "return-type": "json",
        "interval": 120
    },

    "custom/codex": {
        "exec": "$HOME/.config/waybar/scripts/pango.sh codex-usage.sh",
        "return-type": "json",
        "interval": 120
    },

    "custom/copilot": {
        "exec": "$HOME/.config/waybar/scripts/pango.sh copilot-usage.sh",
        "return-type": "json",
        "interval": 120
    },

    "disk": {
        "interval": 25,
        "path": "/",
        "format": "<span foreground='#888888'>DISK</span> {percentage_used}%"
    },

    "pulseaudio": {
        "format": "<span foreground='#888888'>VOL</span> {volume}%",
        "format-muted": "<span foreground='#888888'>VOL</span> <span foreground='#444444'>muted</span>",
        "on-click": "pavucontrol",
        "scroll-step": 5
    },

    "memory": {
        "interval": 2,
        "format": "<span foreground='#888888'>RAM</span> {percentage}%"
    },

    "cpu": {
        "interval": 2,
        "format": "<span foreground='#888888'>CPU</span> {usage}%"
    },

    "custom/network": {
        "exec": "$HOME/.config/waybar/scripts/pango.sh network.sh",
        "return-type": "json",
        "interval": 5,
        "on-click": "nm-connection-editor"
    },

    "custom/tailscale": {
        "exec": "$HOME/.config/waybar/scripts/pango.sh tailscale.sh",
        "return-type": "json",
        "interval": 2,
        "on-click": "$HOME/.config/waybar/scripts/tailscale.sh toggle"
    },

    "custom/battery": {
        "exec": "$HOME/.config/waybar/scripts/pango.sh battery.sh",
        "return-type": "json",
        "interval": 10
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%Y-%m-%d %H:%M:%S}",
        "interval": 1
    },

    "tray": {
        "spacing": 16
    }
}
